# URL Canônica do Site em Produção
NEXT_PUBLIC_SITE_URL=https://tratto.devtorres.com.br

# Disparo de Alertas de Novos Leads (Resend API)
RESEND_API_KEY=re_...
NOTIFICATION_EMAIL_TO=seu-email@exemplo.com
NOTIFICATION_EMAIL_FROM=onboarding@resend.dev

# Chave Secreta para Disparo de Notificações de Changelog (POST /api/changelog/notify)
CHANGELOG_NOTIFY_TOKEN=sua-chave-secreta-aqui

# (Opcional) Persistência de Leads em Banco de Dados Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
